---
import { verifiedIconUrl } from '../lib/content';
interface Props { item: { name: string; icon?: string }; }
const { item } = Astro.props;
const initials: Record<string, string> = {
  '7-Zip': '7z', PixPin: 'Px', Pi: 'Pi', Playwright: 'Pw',
  'Browser Use': 'Bu', 'Chrome DevTools': 'Cd', PCL2: 'PCL',
  PowerToys: 'PT', Obsidian: 'Ob', Anki: 'Ak', 'OBS Studio': 'OBS',
  'Thorium Reader': 'Th', UniGetUI: 'UI', 'CC Switch': 'CC',
  Chrome: 'Ch', Cloudflare: 'Cf', 'Google Play': 'GP',
  'Microsoft Authenticator': 'MA', 'Internet Download Manager': 'IDM',
  'Windows 文件管理器': '文件', ZArchiver: 'ZA', PotPlayer: 'PP',
  'Clash Verge Rev': 'CV', 'res-downloader': 'RD',
};
const src = verifiedIconUrl(item);
---
{src
  ? <img class:list={{ 'icon-backed': item.name === 'GitHub' }} src={src} alt="" width="32" height="32" loading="lazy" />
  : <span class="tool-monogram" aria-hidden="true">{initials[item.name] ?? item.name.slice(0, 2)}</span>}
